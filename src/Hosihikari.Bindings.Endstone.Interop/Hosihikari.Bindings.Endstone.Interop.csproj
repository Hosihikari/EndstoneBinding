<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hosihikari.Bindings.Endstone.Interop</RootNamespace>
    <AssemblyName>Hosihikari.Bindings.Endstone.Interop</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Bindings.Endstone.Interop</PackageId>
    <Version>0.11.15-r0</Version>
    <Authors>Hosihikari</Authors>
    <Description>CI-generated native-style .NET Interop for the Endstone C++ API.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariProjection/EndstoneBinding</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;bedrock;bds;endstone;interop;hosihikari</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(AbiProjectPath)" Condition="'$(AbiProjectPath)' != ''" />
    <ProjectReference Include="../../../Binding.Abi/src/Hosihikari.Bindings.Abi/Hosihikari.Bindings.Abi.csproj" Condition="'$(AbiProjectPath)' == ''" />
  </ItemGroup>

</Project>
